# 复制为 .env 后填写真实值；本文件只放占位符，不入库

# ---- 对话模型（千问兼容模式）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_ENABLE_THINKING=false
REWRITE_TIMEOUT_SECONDS=60

# ---- RAGAS 测评（仅 scripts/eval_ragas.py 使用）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Embedding（本地 bge-m3，稠密 + 稀疏）----
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---- 重排（本地模型）----
RERANK_ENABLED=true
RERANK_MODEL_PATH=./models/bge-reranker-v2-m3
RERANK_CANDIDATES=10
RERANK_SCORE_THRESHOLD=0.3

# ---- 检索 ----
CANDIDATE_K=20
RERANK_CANDIDATES=10
TOP_K=3
SCORE_THRESHOLD=0.35
RERANK_SCORE_THRESHOLD=0.3
RRF_K=60
MAX_CONTEXT_CHARS=6000

# ---- Milvus ----
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=rag_hzg
MILVUS_COLLECTION=rag_project
MILVUS_TOKEN=

# ---- MySQL / Redis ----
MYSQL_URL=mysql+pymysql://root:your_password@localhost:3306/agentic_rag?charset=utf8mb4
REDIS_URL=redis://:your_password@localhost:6379/0
HISTORY_MAX_MESSAGES=20
HISTORY_TTL_SECONDS=3600

# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=logs
ADMIN_TOKEN=change-me
ADMIN_AUTH_ENABLED=false
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
WS_ALLOWED_ORIGINS=http://127.0.0.1:8000
SHOP_NAME=本店
HANDOFF_HINT=建议您联系人工客服

# ---- 1.0 新增：意图识别 ----
INTENT_ENABLED=true
INTENT_TIMEOUT_SECONDS=60
INTENT_MAX_TOKENS=128
CHITCHAT_REPLY=您好呀，闲聊这块我还不太会～不过店铺的事我都能帮您看,有什么想要了解的?
OUT_OF_SCOPE_REPLY=不好意思呀，这个我确实答不上来～我只懂店里的事

# ---- 1.0 新增：高频问答对（BM25）----
FAQ_ENABLED=true
FAQ_SCORE_THRESHOLD=0.8
FAQ_MIN_COVERAGE=0.30
FAQ_MARGIN=0.0
FAQ_SOFTMAX_TEMPERATURE=1.0
FAQ_CACHE_TTL_SECONDS=60
FAQ_IMPORT_MAX_ROWS=2000

# ---- 1.0 新增：查询改写 ----
REWRITE_ENABLED=true
REWRITE_MODE=full
REWRITE_MAX_KEYWORDS=5
HYDE_ENABLED=true
ABBREVIATIONS=

# ---- 1.1 登录鉴权 ----
JWT_SECRET_PATH=data/.jwt_secret
AUTH_COOKIE_NAME=rag_session
AUTH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
ALLOW_ADMIN_SIGNUP=true
CAPTCHA_TTL_SECONDS=300
AUTH_MAX_ATTEMPTS=10
AUTH_LOCK_SECONDS=60
BCRYPT_ROUNDS=12