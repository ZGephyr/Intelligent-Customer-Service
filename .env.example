# 复制为 .env 后填写真实值；本文件只放占位符，不入库

# ---- 对话模型（千问兼容模式）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
REWRITE_TIMEOUT_SECONDS=3

# ---- Embedding（本地 bge-m3，稠密 + 稀疏）----
EMBEDDING_MODEL_PATH=D:\python\eduRAG\rag_qa\models\bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---- 重排（本地模型）----
RERANK_ENABLED=true
RERANK_MODEL_PATH=D:\python\eduRAG\rag_qa\models\bge-reranker-v2-m3
RERANK_CANDIDATES=10
RERANK_SCORE_THRESHOLD=0.3

# ---- 检索 ----
CANDIDATE_K=20
RERANK_CANDIDATES=10
TOP_K=5
SCORE_THRESHOLD=0.35
RERANK_SCORE_THRESHOLD=0.3
RRF_K=60
MAX_CONTEXT_CHARS=6000

# ---- Milvus ----
MILVUS_URI=http://192.168.34.97:19530
MILVUS_DATABASE=rag_hzg
MILVUS_COLLECTION=rag_project
MILVUS_TOKEN=

# ---- MySQL / Redis ----
MYSQL_URL=mysql+pymysql://root:your_password@localhost:3306/agentic_rag?charset=utf8mb4
REDIS_URL=redis://:your_password@localhost:6379/0
HISTORY_MAX_MESSAGES=20
HISTORY_TTL_SECONDS=3600

# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=logs
ADMIN_TOKEN=change-me
ADMIN_AUTH_ENABLED=false
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
WS_ALLOWED_ORIGINS=http://127.0.0.1:8000
SHOP_NAME=本店
HANDOFF_HINT=建议您联系人工客服
